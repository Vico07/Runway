# Copy this file to .env in the same directory and edit locally. Never commit .env.
RUNWAY_HOSTNAME=runway.home.arpa
# Replace this documentation address with the home server's static LAN IPv4 address.
RUNWAY_BIND_IP=192.0.2.10
TZ=America/New_York
# Generate locally with: openssl rand -hex 32
RUNWAY_SECRET_KEY=
# Use your existing OpenID Connect provider (Authentik, Keycloak, etc.).
OIDC_ISSUER=https://auth.example.com/realms/household
OIDC_CLIENT_ID=runway-family
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAILS=you@example.com
